# Supabase. Local values come from `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key (Supabase "secret" or "service_role" key). Used by tests and admin scripts.
# Never prefix with NEXT_PUBLIC_ and never import it from client code.
SUPABASE_SECRET_KEY=
# Comma-separated list of emails allowed to sign in. Empty means nobody can sign in.
ALLOWED_EMAILS=you@example.com
